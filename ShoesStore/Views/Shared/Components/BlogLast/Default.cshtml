@model List<Blog>

@using System.Linq

@{
    var blogs = Model ?? new List<Blog>();
    var b0 = blogs.ElementAtOrDefault(0);
    var b1 = blogs.ElementAtOrDefault(1);
    var b2 = blogs.ElementAtOrDefault(2);
    var b3 = blogs.ElementAtOrDefault(3);
    var b4 = blogs.ElementAtOrDefault(4);
}

<section class="category-area">
    <h2 class="text-center">KARMA BLOGS</h2>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-12">
                <div class="row">
                    <div class="col-lg-8 col-md-8">
                        @if (b0 != null)
                        {
                            <a asp-action="Detail" asp-controller="Blog" asp-route-id="@b0.Mablog">
                                <div class="single-deal">
                                    <div class="overlay"></div>
                                    <img class="img-fluid w-100" src="~/img/blog/@b0.Anhdaidien" alt="" />
                                    <div class="deal-details">
                                        <h6 class="deal-title">Running Collections</h6>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="col-lg-4 col-md-4">
                        @if (b1 != null)
                        {
                            <a asp-action="Detail" asp-controller="Blog" asp-route-id="@b1.Mablog">
                                <div class="single-deal">
                                    <div class="overlay"></div>
                                    <img class="img-fluid w-100" src="~/img/blog/@b1.Anhdaidien" alt="" />
                                    <div class="deal-details">
                                        <h6 class="deal-title">Sneaker for Sports</h6>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="col-lg-4 col-md-4">
                        @if (b2 != null)
                        {
                            <a asp-action="Detail" asp-controller="Blog" asp-route-id="@b2.Mablog">
                                <div class="single-deal">
                                    <div class="overlay"></div>
                                    <img class="img-fluid w-100" src="~/img/blog/@b2.Anhdaidien" alt="" />
                                    <div class="deal-details">
                                        <h6 class="deal-title">Product for Couple</h6>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>

                    <div class="col-lg-8 col-md-8">
                        @if (b3 != null)
                        {
                            <a asp-action="Detail" asp-controller="Blog" asp-route-id="@b3.Mablog">
                                <div class="single-deal">
                                    <div class="overlay"></div>
                                    <img class="img-fluid w-100" src="~/img/blog/@b3.Anhdaidien" alt="" />
                                    <div class="deal-details">
                                        <h6 class="deal-title">Sneaker for Sports</h6>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                @if (b4 != null)
                {
                    <a asp-action="Detail" asp-controller="Blog" asp-route-id="@b4.Mablog">
                        <div class="single-deal">
                            <div class="overlay"></div>
                            <img class="img-fluid w-100" src="~/img/blog/@b4.Anhdaidien" alt="" />
                            <div class="deal-details">
                                <h6 class="deal-title">Sneaker for Sports</h6>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>
