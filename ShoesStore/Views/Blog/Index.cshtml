@model List<ShoesStore.Models.Blog>

@{
    ViewData["Title"] = "Blog List";
}

<!-- End Header Area -->
<!-- Start Banner Area -->
<section class="banner-area organic-breadcrumb">
    <div class="container">
        <div class="breadcrumb-banner d-flex flex-wrap align-items-center justify-content-end">
            <div class="col-first">
                <h1>Blog Page</h1>
                <nav class="d-flex align-items-center">
                    <a href="index.html">Home<span class="lnr lnr-arrow-right"></span></a>
                    <a href="category.html">Blog</a>
                </nav>
            </div>
        </div>
    </div>
</section>
<!-- End Banner Area -->
<!--================Blog Categorie Area =================-->

<div class="container blog-section" style="border-radius:3px">
    <h2 class="text-center mb-4" style="margin-top:35px">Blog List</h2>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var blog in Model)
        {
            <div class="col">
                <div class="card h-100">
                    <img src="@Url.Content($"~/img/blog/{blog.Anhdaidien}")"
                         class="card-img-top"
                         style="height:225px; object-fit:cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@blog.Theloai</h5>
                        <p class="card-text flex-grow-1">
                            @Html.Raw(blog.Noidung.Substring(0, Math.Min(blog.Noidung.Length, 100)))...
                        </p>
                        <a href="@Url.Action("Detail", "Blog", new { id = blog.Mablog })"
                           class="btn btn-outline-primary mt-auto">View More</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
<style>
    /* Reset row cho đúng grid */
    .blog-section .row {
        display: flex !important;
        flex-wrap: wrap !important;
        margin-left: -12px !important;
        margin-right: -12px !important;
    }

    /* Ép cứng mỗi item = 1/3 width */
    .blog-section .col {
        flex: 0 0 33.333333% !important;
        max-width: 33.333333% !important;
        padding-left: 12px !important;
        padding-right: 12px !important;
        margin-bottom: 35px !important;
        box-sizing: border-box !important;
        float: none !important;
    }

    /* card chuẩn */
    .blog-section .card {
        display: flex;
        flex-direction: column;
        height: 100% !important;
        /* border: 2px solid #ccc !important;
        border-radius: 10px !important; */
    }

    /* ảnh không bị méo */
    .blog-section .card-img-top {
        width: 100% !important;
        height: 225px !important;
        object-fit: cover !important;
        display: block !important;
    }

</style>




